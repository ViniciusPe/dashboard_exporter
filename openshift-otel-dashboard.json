{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": { "type": "grafana", "uid": "-- Grafana --" },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "description": "Dashboard profissional OpenShift com métricas OpenTelemetry (OTel). Variáveis derivadas de container_cpu_usage. Inclui Overview, API Server, etcd, Nodes, Pods, Containers, Storage e HAProxy/Router.",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "tags": ["openshift", "otel", "kubernetes", "observability"],
  "templating": {
    "list": [
      {
        "current": { "selected": false, "text": "Prometheus", "value": "Prometheus" },
        "label": "Datasource",
        "name": "datasource",
        "options": [],
        "query": "prometheus",
        "refresh": 1,
        "regex": "",
        "skipUrlSync": false,
        "type": "datasource"
      },
      {
        "datasource": { "type": "prometheus", "uid": "${datasource}" },
        "definition": "label_values(container_cpu_usage, k8s_cluster_name)",
        "includeAll": true,
        "label": "Cluster",
        "multi": true,
        "name": "k8s_cluster_name",
        "options": [],
        "query": { "query": "label_values(container_cpu_usage, k8s_cluster_name)", "refId": "StandardVariableQuery" },
        "refresh": 2,
        "regex": "",
        "sort": 1,
        "type": "query"
      },
      {
        "datasource": { "type": "prometheus", "uid": "${datasource}" },
        "definition": "label_values(container_cpu_usage{k8s_cluster_name=~\"$k8s_cluster_name\"}, k8s_namespace_name)",
        "includeAll": true,
        "label": "Namespace",
        "multi": true,
        "name": "k8s_namespace_name",
        "options": [],
        "query": { "query": "label_values(container_cpu_usage{k8s_cluster_name=~\"$k8s_cluster_name\"}, k8s_namespace_name)", "refId": "StandardVariableQuery" },
        "refresh": 2,
        "regex": "",
        "sort": 1,
        "type": "query"
      },
      {
        "datasource": { "type": "prometheus", "uid": "${datasource}" },
        "definition": "label_values(container_cpu_usage{k8s_cluster_name=~\"$k8s_cluster_name\", k8s_namespace_name=~\"$k8s_namespace_name\"}, k8s_node_name)",
        "includeAll": true,
        "label": "Node",
        "multi": true,
        "name": "k8s_node_name",
        "options": [],
        "query": { "query": "label_values(container_cpu_usage{k8s_cluster_name=~\"$k8s_cluster_name\", k8s_namespace_name=~\"$k8s_namespace_name\"}, k8s_node_name)", "refId": "StandardVariableQuery" },
        "refresh": 2,
        "regex": "",
        "sort": 1,
        "type": "query"
      },
      {
        "datasource": { "type": "prometheus", "uid": "${datasource}" },
        "definition": "label_values(container_cpu_usage{k8s_cluster_name=~\"$k8s_cluster_name\", k8s_namespace_name=~\"$k8s_namespace_name\"}, k8s_workload_name)",
        "includeAll": true,
        "label": "Workload",
        "multi": true,
        "name": "k8s_workload_name",
        "options": [],
        "query": { "query": "label_values(container_cpu_usage{k8s_cluster_name=~\"$k8s_cluster_name\", k8s_namespace_name=~\"$k8s_namespace_name\"}, k8s_workload_name)", "refId": "StandardVariableQuery" },
        "refresh": 2,
        "regex": "",
        "sort": 1,
        "type": "query"
      },
      {
        "datasource": { "type": "prometheus", "uid": "${datasource}" },
        "definition": "label_values(container_cpu_usage{k8s_cluster_name=~\"$k8s_cluster_name\", k8s_namespace_name=~\"$k8s_namespace_name\", k8s_workload_name=~\"$k8s_workload_name\"}, k8s_pod_name)",
        "includeAll": true,
        "label": "Pod",
        "multi": true,
        "name": "k8s_pod_name",
        "options": [],
        "query": { "query": "label_values(container_cpu_usage{k8s_cluster_name=~\"$k8s_cluster_name\", k8s_namespace_name=~\"$k8s_namespace_name\", k8s_workload_name=~\"$k8s_workload_name\"}, k8s_pod_name)", "refId": "StandardVariableQuery" },
        "refresh": 2,
        "regex": "",
        "sort": 1,
        "type": "query"
      },
      {
        "datasource": { "type": "prometheus", "uid": "${datasource}" },
        "definition": "label_values(container_cpu_usage{k8s_cluster_name=~\"$k8s_cluster_name\", k8s_namespace_name=~\"$k8s_namespace_name\", k8s_pod_name=~\"$k8s_pod_name\"}, k8s_container_name)",
        "includeAll": true,
        "label": "Container",
        "multi": true,
        "name": "k8s_container_name",
        "options": [],
        "query": { "query": "label_values(container_cpu_usage{k8s_cluster_name=~\"$k8s_cluster_name\", k8s_namespace_name=~\"$k8s_namespace_name\", k8s_pod_name=~\"$k8s_pod_name\"}, k8s_container_name)", "refId": "StandardVariableQuery" },
        "refresh": 2,
        "regex": "",
        "sort": 1,
        "type": "query"
      }
    ]
  },
  "time": { "from": "now-1h", "to": "now" },
  "timepicker": {},
  "timezone": "browser",
  "title": "OpenShift - OTel Observability",
  "refresh": "30s",
  "schemaVersion": 39,
  "version": 2,
  "weekStart": "",
  "panels": [
    {
      "type": "row",
      "id": 1,
      "title": "🏠 Overview - Big Numbers",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "panels": []
    },
    {
      "type": "stat",
      "id": 2,
      "title": "Clusters",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 4, "w": 3, "x": 0, "y": 1 },
      "options": { "colorMode": "value", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [{ "color": "blue" }] }, "unit": "short" } },
      "targets": [{ "expr": "count(count by(k8s_cluster_name)(container_cpu_usage{k8s_cluster_name=~\"$k8s_cluster_name\"}))", "refId": "A" }]
    },
    {
      "type": "stat",
      "id": 3,
      "title": "Total Nodes",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 4, "w": 3, "x": 3, "y": 1 },
      "options": { "colorMode": "value", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [{ "color": "green" }] }, "unit": "short" } },
      "targets": [{ "expr": "count(count by(k8s_node_name)(container_cpu_usage{k8s_cluster_name=~\"$k8s_cluster_name\"}))", "refId": "A" }]
    },
    {
      "type": "stat",
      "id": 4,
      "title": "Nodes Ready",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 4, "w": 3, "x": 6, "y": 1 },
      "options": { "colorMode": "value", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [{ "color": "red" }, { "color": "green", "value": 1 }] }, "unit": "short" } },
      "targets": [{ "expr": "sum(k8s_node_condition{k8s_cluster_name=~\"$k8s_cluster_name\", condition=\"Ready\", status=\"true\"})", "refId": "A" }]
    },
    {
      "type": "stat",
      "id": 5,
      "title": "Namespaces",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 4, "w": 3, "x": 9, "y": 1 },
      "options": { "colorMode": "value", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [{ "color": "purple" }] }, "unit": "short" } },
      "targets": [{ "expr": "count(count by(k8s_namespace_name)(container_cpu_usage{k8s_cluster_name=~\"$k8s_cluster_name\"}))", "refId": "A" }]
    },
    {
      "type": "stat",
      "id": 6,
      "title": "Running Pods",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 4, "w": 3, "x": 12, "y": 1 },
      "options": { "colorMode": "value", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [{ "color": "blue" }] }, "unit": "short" } },
      "targets": [{ "expr": "count(count by(k8s_pod_name)(container_cpu_usage{k8s_cluster_name=~\"$k8s_cluster_name\", k8s_namespace_name=~\"$k8s_namespace_name\"}))", "refId": "A" }]
    },
    {
      "type": "stat",
      "id": 7,
      "title": "Container Restarts (1h)",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 4, "w": 3, "x": 15, "y": 1 },
      "options": { "colorMode": "value", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [{ "color": "green" }, { "color": "yellow", "value": 1 }, { "color": "red", "value": 10 }] }, "unit": "short" } },
      "targets": [{ "expr": "sum(increase(k8s_container_restarts{k8s_cluster_name=~\"$k8s_cluster_name\", k8s_namespace_name=~\"$k8s_namespace_name\"}[1h]))", "refId": "A" }]
    },
    {
      "type": "stat",
      "id": 8,
      "title": "API Server Error Rate (5xx)",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 4, "w": 3, "x": 18, "y": 1 },
      "options": { "colorMode": "value", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [{ "color": "green" }, { "color": "yellow", "value": 0.01 }, { "color": "red", "value": 0.05 }] }, "unit": "percentunit" } },
      "targets": [{ "expr": "sum(rate(apiserver_request_total{code=~\"5..\", k8s_cluster_name=~\"$k8s_cluster_name\"}[5m])) / clamp_min(sum(rate(apiserver_request_total{k8s_cluster_name=~\"$k8s_cluster_name\"}[5m])), 1)", "refId": "A" }]
    },
    {
      "type": "stat",
      "id": 9,
      "title": "etcd DB Size",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 4, "w": 3, "x": 21, "y": 1 },
      "options": { "colorMode": "value", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [{ "color": "green" }, { "color": "yellow", "value": 4000000000 }, { "color": "red", "value": 7000000000 }] }, "unit": "bytes" } },
      "targets": [{ "expr": "max(etcd_mvcc_db_total_size_in_bytes{k8s_cluster_name=~\"$k8s_cluster_name\"})", "refId": "A" }]
    },
    {
      "type": "stat",
      "id": 10,
      "title": "API Server Avg Latency",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 5 },
      "options": { "colorMode": "value", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [{ "color": "green" }, { "color": "yellow", "value": 0.5 }, { "color": "red", "value": 1 }] }, "unit": "s" } },
      "targets": [{ "expr": "sum(rate(apiserver_request_duration_seconds_sum{k8s_cluster_name=~\"$k8s_cluster_name\"}[5m])) / clamp_min(sum(rate(apiserver_request_duration_seconds_count{k8s_cluster_name=~\"$k8s_cluster_name\"}[5m])), 1)", "refId": "A" }]
    },
    {
      "type": "stat",
      "id": 11,
      "title": "Cluster CPU Usage",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 4, "w": 4, "x": 4, "y": 5 },
      "options": { "colorMode": "value", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [{ "color": "green" }, { "color": "yellow", "value": 70 }, { "color": "red", "value": 90 }] }, "unit": "percent" } },
      "targets": [{ "expr": "100 * sum(k8s_node_cpu_usage{k8s_cluster_name=~\"$k8s_cluster_name\"}) / clamp_min(sum(kube_node_status_allocatable{k8s_cluster_name=~\"$k8s_cluster_name\", resource=\"cpu\"}), 1)", "refId": "A" }]
    },
    {
      "type": "stat",
      "id": 12,
      "title": "Cluster Memory Usage",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 4, "w": 4, "x": 8, "y": 5 },
      "options": { "colorMode": "value", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [{ "color": "green" }, { "color": "yellow", "value": 70 }, { "color": "red", "value": 90 }] }, "unit": "percent" } },
      "targets": [{ "expr": "100 * sum(k8s_node_memory_usage_bytes{k8s_cluster_name=~\"$k8s_cluster_name\"}) / clamp_min(sum(kube_node_status_allocatable{k8s_cluster_name=~\"$k8s_cluster_name\", resource=\"memory\"}), 1)", "refId": "A" }]
    },
    {
      "type": "stat",
      "id": 13,
      "title": "HAProxy 5xx Rate",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 4, "w": 4, "x": 12, "y": 5 },
      "options": { "colorMode": "value", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [{ "color": "green" }, { "color": "yellow", "value": 1 }, { "color": "red", "value": 10 }] }, "unit": "reqps" } },
      "targets": [{ "expr": "sum(rate(haproxy_backend_http_responses_total{code=\"5xx\", k8s_cluster_name=~\"$k8s_cluster_name\"}[5m]))", "refId": "A" }]
    },
    {
      "type": "stat",
      "id": 14,
      "title": "HAProxy 4xx Rate",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 4, "w": 4, "x": 16, "y": 5 },
      "options": { "colorMode": "value", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [{ "color": "green" }, { "color": "yellow", "value": 5 }, { "color": "red", "value": 50 }] }, "unit": "reqps" } },
      "targets": [{ "expr": "sum(rate(haproxy_backend_http_responses_total{code=\"4xx\", k8s_cluster_name=~\"$k8s_cluster_name\"}[5m]))", "refId": "A" }]
    },
    {
      "type": "stat",
      "id": 15,
      "title": "etcd WAL fsync Avg",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 4, "w": 4, "x": 20, "y": 5 },
      "options": { "colorMode": "value", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [{ "color": "green" }, { "color": "yellow", "value": 0.025 }, { "color": "red", "value": 0.1 }] }, "unit": "s" } },
      "targets": [{ "expr": "sum(rate(etcd_disk_wal_fsync_duration_seconds_sum{k8s_cluster_name=~\"$k8s_cluster_name\"}[5m])) / clamp_min(sum(rate(etcd_disk_wal_fsync_duration_seconds_count{k8s_cluster_name=~\"$k8s_cluster_name\"}[5m])), 1)", "refId": "A" }]
