        "gridPos": { "h": 7, "w": 24, "x": 0, "y": 91 },
        "targets": [
          { "expr": "sum(rate(ceph_rocksdb_rocksdb_write_wal_time_sum_total{k8s_cluster_name=\"$cluster\"}[5m])) / sum(rate(ceph_rocksdb_rocksdb_write_wal_time_count_total{k8s_cluster_name=\"$cluster\"}[5m]))", "refId": "A", "legendFormat": "wal" },
          { "expr": "sum(rate(ceph_rocksdb_rocksdb_write_memtable_time_sum_total{k8s_cluster_name=\"$cluster\"}[5m])) / sum(rate(ceph_rocksdb_rocksdb_write_memtable_time_count_total{k8s_cluster_name=\"$cluster\"}[5m]))", "refId": "B", "legendFormat": "memtable" },
          { "expr": "sum(rate(ceph_rocksdb_rocksdb_write_pre_and_post_time_sum_total{k8s_cluster_name=\"$cluster\"}[5m])) / sum(rate(ceph_rocksdb_rocksdb_write_pre_and_post_time_count_total{k8s_cluster_name=\"$cluster\"}[5m]))", "refId": "C", "legendFormat": "pre/post" },
          { "expr": "sum(rate(ceph_rocksdb_rocksdb_write_delay_time_sum_total{k8s_cluster_name=\"$cluster\"}[5m])) / sum(rate(ceph_rocksdb_rocksdb_write_delay_time_count_total{k8s_cluster_name=\"$cluster\"}[5m]))", "refId": "D", "legendFormat": "delay" }
        ],
        "fieldConfig": { "defaults": { "unit": "s" } }
      }
    ]}
