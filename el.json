          { "expr": "sum(rate(ceph_rocksdb_compact_completed_total{k8s_cluster_name=\"$cluster\"}[5m]))", "refId": "A", "legendFormat": "completed/s" },
          { "expr": "sum(rate(ceph_rocksdb_compact_running_total{k8s_cluster_name=\"$cluster\"}[5m]))", "refId": "B", "legendFormat": "running/s" },
          { "expr": "sum(ceph_rocksdb_compact_queue_len{k8s_cluster_name=\"$cluster\"})", "refId": "C", "legendFormat": "queue len" }
        ],
        "fieldConfig": { "defaults": { "unit": "short" } }
      },
      {
        "type": "timeseries", "id": 121,
        "title": "RocksDB - Latência",
        "description": "Latências médias de get, submit e submit_sync.",
        "datasource": { "type": "prometheus", "uid": "${DS_PROM}" },
        "gridPos": { "h": 7, "w": 12, "x": 12, "y": 84 },
        "targets": [
          { "expr": "sum(rate(ceph_rocksdb_get_latency_sum_total{k8s_cluster_name=\"$cluster\"}[5m])) / sum(rate(ceph_rocksdb_get_latency_count_total{k8s_cluster_name=\"$cluster\"}[5m]))", "refId": "A", "legendFormat": "get" },
          { "expr": "sum(rate(ceph_rocksdb_submit_latency_sum_total{k8s_cluster_name=\"$cluster\"}[5m])) / sum(rate(ceph_rocksdb_submit_latency_count_total{k8s_cluster_name=\"$cluster\"}[5m]))", "refId": "B", "legendFormat": "submit" },
          { "expr": "sum(rate(ceph_rocksdb_submit_sync_latency_sum_total{k8s_cluster_name=\"$cluster\"}[5m])) / sum(rate(ceph_rocksdb_submit_sync_latency_count_total{k8s_cluster_name=\"$cluster\"}[5m]))", "refId": "C", "legendFormat": "submit_sync" }
        ],
        "fieldConfig": { "defaults": { "unit": "s" } }
      },
      {
        "type": "timeseries", "id": 122,
        "title": "RocksDB - Tempos de Write",
