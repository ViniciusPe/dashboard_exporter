        "description": "Bytes originais vs. alocados após compressão.",
        "datasource": { "type": "prometheus", "uid": "${DS_PROM}" },
        "gridPos": { "h": 7, "w": 12, "x": 0, "y": 97 },
        "targets": [
          { "expr": "sum(ceph_bluestore_compressed_original{k8s_cluster_name=\"$cluster\"})", "refId": "A", "legendFormat": "original" },
          { "expr": "sum(ceph_bluestore_compressed{k8s_cluster_name=\"$cluster\"})", "refId": "B", "legendFormat": "compressed" },
          { "expr": "sum(ceph_bluestore_compressed_allocated{k8s_cluster_name=\"$cluster\"})", "refId": "C", "legendFormat": "allocated" }
        ],
        "fieldConfig": { "defaults": { "unit": "bytes" } }
      },
      {
        "type": "timeseries", "id": 95,
        "title": "BlueStore - Reads com Retries",
