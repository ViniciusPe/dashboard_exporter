        "datasource": { "type": "prometheus", "uid": "${DS_PROM}" },
        "gridPos": { "h": 7, "w": 12, "x": 12, "y": 97 },
        "targets": [
          { "expr": "sum(rate(ceph_bluestore_reads_with_retries_total{k8s_cluster_name=\"$cluster\"}[5m]))", "refId": "A", "legendFormat": "retries/s" }
