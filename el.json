        "fieldConfig": { "defaults": { "unit": "ops" } }
      }
    ]},

    { "type": "row", "id": 110, "title": "RocksDB", "gridPos": { "h": 1, "w": 24, "x": 0, "y": 83 }, "collapsed": true, "panels": [
      {
        "type": "timeseries", "id": 120,
