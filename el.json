{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": { "type": "grafana", "uid": "-- Grafana --" },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "description": "Dashboard profissional para monitoramento de clusters Ceph via OpenTelemetry. Agrupado por: Visão Geral, Capacidade, OSD/PG, Pools, MON, MDS, RGW, RBD, BlueStore/BlueFS e RocksDB.",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "liveNow": false,
  "refresh": "30s",
  "schemaVersion": 39,
  "tags": ["ceph", "storage", "otel"],
  "templating": {
    "list": [
      {
        "current": { "selected": false, "text": "Prometheus", "value": "Prometheus" },
        "hide": 0,
        "includeAll": false,
        "label": "Datasource",
        "multi": false,
        "name": "DS_PROM",
        "options": [],
        "query": "prometheus",
        "refresh": 1,
        "regex": "",
        "skipUrlSync": false,
        "type": "datasource"
      },
      {
        "datasource": { "type": "prometheus", "uid": "${DS_PROM}" },
        "definition": "label_values(ceph_health_status, k8s_cluster_name)",
        "hide": 0,
        "includeAll": false,
        "label": "Cluster (k8s_cluster_name)",
        "multi": false,
        "name": "cluster",
        "options": [],
        "query": { "query": "label_values(ceph_health_status, k8s_cluster_name)", "refId": "StandardVariableQuery" },
        "refresh": 2,
        "regex": "",
        "skipUrlSync": false,
        "sort": 1,
        "type": "query"
      }
    ]
  },
  "time": { "from": "now-6h", "to": "now" },
  "timepicker": {},
  "timezone": "",
  "title": "Ceph Cluster Overview (OTel)",
  "uid": "ceph-otel-overview",
  "version": 1,
  "weekStart": "",
  "panels": [
    {
      "type": "row",
      "id": 100,
      "title": "Visão Geral do Cluster",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "collapsed": false,
      "panels": []
    },
    {
      "type": "stat",
      "id": 1,
      "title": "Status de Saúde",
      "description": "Estado de saúde geral do cluster. 0=HEALTH_OK, 1=HEALTH_WARN, 2=HEALTH_ERR.",
      "datasource": { "type": "prometheus", "uid": "${DS_PROM}" },
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 1 },
      "targets": [
        { "expr": "max(ceph_health_status{k8s_cluster_name=\"$cluster\"})", "refId": "A" }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "type": "value", "options": { "0": { "text": "HEALTH_OK", "color": "green", "index": 0 } } },
            { "type": "value", "options": { "1": { "text": "HEALTH_WARN", "color": "yellow", "index": 1 } } },
            { "type": "value", "options": { "2": { "text": "HEALTH_ERR", "color": "red", "index": 2 } } }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 1 },
              { "color": "red", "value": 2 }
            ]
          },
          "color": { "mode": "thresholds" }
        }
      },
      "options": { "colorMode": "background", "graphMode": "none", "textMode": "value", "reduceOptions": { "calcs": ["lastNotNull"] } }
    },
    {
      "type": "stat",
      "id": 2,
      "title": "OSDs UP / Total",
      "description": "Quantidade de OSDs no estado UP versus o total conhecido pelo cluster.",
      "datasource": { "type": "prometheus", "uid": "${DS_PROM}" },
      "gridPos": { "h": 4, "w": 4, "x": 4, "y": 1 },
      "targets": [
        { "expr": "sum(ceph_osd_up{k8s_cluster_name=\"$cluster\"})", "refId": "A", "legendFormat": "UP" },
        { "expr": "count(ceph_osd_metadata{k8s_cluster_name=\"$cluster\"})", "refId": "B", "legendFormat": "Total" }
      ],
      "options": { "colorMode": "value", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "fieldConfig": { "defaults": { "unit": "short", "color": { "mode": "palette-classic" } } }
    },
    {
      "type": "stat",
      "id": 3,
      "title": "OSDs IN",
      "description": "Número de OSDs marcados como IN (participando do cluster).",
      "datasource": { "type": "prometheus", "uid": "${DS_PROM}" },
      "gridPos": { "h": 4, "w": 4, "x": 8, "y": 1 },
      "targets": [{ "expr": "sum(ceph_osd_in{k8s_cluster_name=\"$cluster\"})", "refId": "A" }],
      "fieldConfig": { "defaults": { "unit": "short" } }
    },
    {
      "type": "stat",
      "id": 4,
      "title": "MONs em Quórum",
      "description": "Quantidade de monitores (MON) participando do quórum.",
      "datasource": { "type": "prometheus", "uid": "${DS_PROM}" },
      "gridPos": { "h": 4, "w": 4, "x": 12, "y": 1 },
      "targets": [{ "expr": "sum(ceph_mon_quorum_status{k8s_cluster_name=\"$cluster\"})", "refId": "A" }],
      "fieldConfig": { "defaults": { "unit": "short" } }
    },
    {
      "type": "stat",
      "id": 5,
      "title": "PGs Ativos",
      "description": "Placement Groups em estado ativo.",
      "datasource": { "type": "prometheus", "uid": "${DS_PROM}" },
      "gridPos": { "h": 4, "w": 4, "x": 16, "y": 1 },
      "targets": [{ "expr": "sum(ceph_pg_active{k8s_cluster_name=\"$cluster\"})", "refId": "A" }],
      "fieldConfig": { "defaults": { "unit": "short" } }
    },
    {
      "type": "stat",
      "id": 6,
      "title": "Slow Ops",
      "description": "Operações lentas detectadas pelo healthcheck do Ceph.",
      "datasource": { "type": "prometheus", "uid": "${DS_PROM}" },
      "gridPos": { "h": 4, "w": 4, "x": 20, "y": 1 },
      "targets": [{ "expr": "sum(ceph_healthcheck_slow_ops{k8s_cluster_name=\"$cluster\"})", "refId": "A" }],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "green", "value": null },
            { "color": "yellow", "value": 1 },
            { "color": "red", "value": 10 }
          ]},
          "color": { "mode": "thresholds" }
        }
      },
      "options": { "colorMode": "background" }
    },

    { "type": "row", "id": 101, "title": "Capacidade", "gridPos": { "h": 1, "w": 24, "x": 0, "y": 5 }, "collapsed": false, "panels": [] },
    {
      "type": "gauge",
      "id": 10,
      "title": "Uso Total do Cluster",
      "description": "Percentual utilizado em relação à capacidade total bruta do cluster.",
      "datasource": { "type": "prometheus", "uid": "${DS_PROM}" },
      "gridPos": { "h": 7, "w": 6, "x": 0, "y": 6 },
      "targets": [
        { "expr": "sum(ceph_cluster_total_used_bytes{k8s_cluster_name=\"$cluster\"}) / sum(ceph_cluster_total_bytes{k8s_cluster_name=\"$cluster\"}) * 100", "refId": "A" }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent", "min": 0, "max": 100,
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "green", "value": null },
            { "color": "yellow", "value": 70 },
            { "color": "orange", "value": 80 },
            { "color": "red", "value": 90 }
          ]}
        }
      }
    },
    {
      "type": "stat",
      "id": 11,
      "title": "Capacidade Total",
      "description": "Capacidade bruta total do cluster.",
      "datasource": { "type": "prometheus", "uid": "${DS_PROM}" },
      "gridPos": { "h": 3, "w": 6, "x": 6, "y": 6 },
      "targets": [{ "expr": "sum(ceph_cluster_total_bytes{k8s_cluster_name=\"$cluster\"})", "refId": "A" }],
      "fieldConfig": { "defaults": { "unit": "bytes" } }
    },
    {
      "type": "stat",
      "id": 12,
      "title": "Usado (Bruto)",
      "description": "Total bruto utilizado considerando replicação/EC.",
      "datasource": { "type": "prometheus", "uid": "${DS_PROM}" },
      "gridPos": { "h": 3, "w": 6, "x": 12, "y": 6 },
      "targets": [{ "expr": "sum(ceph_cluster_total_used_raw_bytes{k8s_cluster_name=\"$cluster\"})", "refId": "A" }],
      "fieldConfig": { "defaults": { "unit": "bytes" } }
    },
    {
      "type": "stat",
      "id": 13,
      "title": "Usado (Lógico)",
      "description": "Total lógico utilizado (dados do usuário sem considerar replicação).",
      "datasource": { "type": "prometheus", "uid": "${DS_PROM}" },
      "gridPos": { "h": 3, "w": 6, "x": 18, "y": 6 },
      "targets": [{ "expr": "sum(ceph_cluster_total_used_bytes{k8s_cluster_name=\"$cluster\"})", "refId": "A" }],
      "fieldConfig": { "defaults": { "unit": "bytes" } }
    },
    {
      "type": "timeseries",
      "id": 14,
      "title": "Crescimento de Capacidade",
      "description": "Evolução temporal de capacidade total e uso do cluster.",
      "datasource": { "type": "prometheus", "uid": "${DS_PROM}" },
      "gridPos": { "h": 8, "w": 18, "x": 6, "y": 9 },
      "targets": [
        { "expr": "sum(ceph_cluster_total_bytes{k8s_cluster_name=\"$cluster\"})", "refId": "A", "legendFormat": "Total" },
        { "expr": "sum(ceph_cluster_total_used_raw_bytes{k8s_cluster_name=\"$cluster\"})", "refId": "B", "legendFormat": "Usado (bruto)" },
        { "expr": "sum(ceph_cluster_total_used_bytes{k8s_cluster_name=\"$cluster\"})", "refId": "C", "legendFormat": "Usado (lógico)" }
      ],
      "fieldConfig": { "defaults": { "unit": "bytes", "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 10 } } }
    },
    {
      "type": "piechart",
      "id": 15,
      "title": "Capacidade por Device Class",
      "description": "Distribuição de capacidade total por classe de dispositivo (hdd/ssd/nvme).",
      "datasource": { "type": "prometheus", "uid": "${DS_PROM}" },
      "gridPos": { "h": 8, "w": 6, "x": 0, "y": 13 },
      "targets": [
        { "expr": "sum by (device_class) (ceph_cluster_by_class_total_bytes{k8s_cluster_name=\"$cluster\"})", "refId": "A", "legendFormat": "{{device_class}}" }
      ],
      "fieldConfig": { "defaults": { "unit": "bytes" } },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "pieType": "donut" }
    },

    { "type": "row", "id": 102, "title": "Placement Groups (PGs)", "gridPos": { "h": 1, "w": 24, "x": 0, "y": 21 }, "collapsed": false, "panels": [] },
    {
      "type": "stat",
      "id": 20,
      "title": "Total de PGs",
      "description": "Número total de Placement Groups no cluster.",
      "datasource": { "type": "prometheus", "uid": "${DS_PROM}" },
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 22 },
      "targets": [{ "expr": "sum(ceph_pg_total{k8s_cluster_name=\"$cluster\"})", "refId": "A" }],
      "fieldConfig": { "defaults": { "unit": "short" } }
    },
    {
      "type": "stat",
      "id": 21,
      "title": "PGs Clean",
      "description": "PGs em estado clean (saudáveis).",
      "datasource": { "type": "prometheus", "uid": "${DS_PROM}" },
      "gridPos": { "h": 4, "w": 4, "x": 4, "y": 22 },
      "targets": [{ "expr": "sum(ceph_pg_clean{k8s_cluster_name=\"$cluster\"})", "refId": "A" }],
      "fieldConfig": { "defaults": { "unit": "short", "color": { "mode": "fixed", "fixedColor": "green" } } }
    },
    {
      "type": "stat",
      "id": 22,
      "title": "PGs Degraded",
      "description": "PGs com réplicas faltantes.",
      "datasource": { "type": "prometheus", "uid": "${DS_PROM}" },
      "gridPos": { "h": 4, "w": 4, "x": 8, "y": 22 },
      "targets": [{ "expr": "sum(ceph_pg_degraded{k8s_cluster_name=\"$cluster\"})", "refId": "A" }],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "green", "value": null },
            { "color": "yellow", "value": 1 }
          ]},
          "color": { "mode": "thresholds" }
        }
      }
    },
    {
      "type": "stat",
      "id": 23,
      "title": "PGs Inconsistent",
      "description": "PGs com inconsistência detectada por scrubbing.",
      "datasource": { "type": "prometheus", "uid": "${DS_PROM}" },
      "gridPos": { "h": 4, "w": 4, "x": 12, "y": 22 },
      "targets": [{ "expr": "sum(ceph_pg_inconsistent{k8s_cluster_name=\"$cluster\"})", "refId": "A" }],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "green", "value": null },
            { "color": "red", "value": 1 }
          ]},
          "color": { "mode": "thresholds" }
        }
      }
    },
    {
      "type": "stat",
      "id": 24,
      "title": "Objetos Unfound",
      "description": "Objetos que o cluster não consegue localizar.",
      "datasource": { "type": "prometheus", "uid": "${DS_PROM}" },
      "gridPos": { "h": 4, "w": 4, "x": 16, "y": 22 },
      "targets": [{ "expr": "sum(ceph_num_objects_unfound{k8s_cluster_name=\"$cluster\"})", "refId": "A" }],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "green", "value": null },
            { "color": "red", "value": 1 }
          ]},
          "color": { "mode": "thresholds" }
        }
      }
    },
    {
      "type": "stat",
      "id": 25,
      "title": "Objetos Misplaced",
      "description": "Objetos em OSDs diferentes do destino planejado.",
      "datasource": { "type": "prometheus", "uid": "${DS_PROM}" },
      "gridPos": { "h": 4, "w": 4, "x": 20, "y": 22 },
      "targets": [{ "expr": "sum(ceph_num_objects_misplaced{k8s_cluster_name=\"$cluster\"})", "refId": "A" }],
      "fieldConfig": { "defaults": { "unit": "short" } }
    },
    {
      "type": "timeseries",
      "id": 26,
      "title": "Distribuição de Estados de PG",
      "description": "Série temporal de PGs nos principais estados operacionais.",
      "datasource": { "type": "prometheus", "uid": "${DS_PROM}" },
      "gridPos": { "h": 9, "w": 24, "x": 0, "y": 26 },
      "targets": [
        { "expr": "sum(ceph_pg_active{k8s_cluster_name=\"$cluster\"})", "refId": "A", "legendFormat": "active" },
        { "expr": "sum(ceph_pg_clean{k8s_cluster_name=\"$cluster\"})", "refId": "B", "legendFormat": "clean" },
        { "expr": "sum(ceph_pg_degraded{k8s_cluster_name=\"$cluster\"})", "refId": "C", "legendFormat": "degraded" },
        { "expr": "sum(ceph_pg_recovering{k8s_cluster_name=\"$cluster\"})", "refId": "D", "legendFormat": "recovering" },
        { "expr": "sum(ceph_pg_backfilling{k8s_cluster_name=\"$cluster\"})", "refId": "E", "legendFormat": "backfilling" },
        { "expr": "sum(ceph_pg_peering{k8s_cluster_name=\"$cluster\"})", "refId": "F", "legendFormat": "peering" },
        { "expr": "sum(ceph_pg_scrubbing{k8s_cluster_name=\"$cluster\"})", "refId": "G", "legendFormat": "scrubbing" },
        { "expr": "sum(ceph_pg_inconsistent{k8s_cluster_name=\"$cluster\"})", "refId": "H", "legendFormat": "inconsistent" },
        { "expr": "sum(ceph_pg_stale{k8s_cluster_name=\"$cluster\"})", "refId": "I", "legendFormat": "stale" },
        { "expr": "sum(ceph_pg_undersized{k8s_cluster_name=\"$cluster\"})", "refId": "J", "legendFormat": "undersized" }
      ],
      "fieldConfig": { "defaults": { "unit": "short", "custom": { "drawStyle": "line", "lineWidth": 1, "fillOpacity": 10, "stacking": { "mode": "normal" } } } }
    },

    { "type": "row", "id": 103, "title": "OSD - Performance & I/O", "gridPos": { "h": 1, "w": 24, "x": 0, "y": 35 }, "collapsed": false, "panels": [] },
    {
      "type": "timeseries",
      "id": 30,
      "title": "IOPS por Tipo de Operação",
      "description": "Taxa de operações por segundo nos OSDs (read, write, read-modify-write).",
      "datasource": { "type": "prometheus", "uid": "${DS_PROM}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 36 },
      "targets": [
        { "expr": "sum(rate(ceph_osd_op_r_total{k8s_cluster_name=\"$cluster\"}[5m]))", "refId": "A", "legendFormat": "read" },
        { "expr": "sum(rate(ceph_osd_op_w_total{k8s_cluster_name=\"$cluster\"}[5m]))", "refId": "B", "legendFormat": "write" },
        { "expr": "sum(rate(ceph_osd_op_rw_total{k8s_cluster_name=\"$cluster\"}[5m]))", "refId": "C", "legendFormat": "read-modify-write" }
      ],
      "fieldConfig": { "defaults": { "unit": "ops", "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 10 } } }
    },
    {
      "type": "timeseries",
      "id": 31,
      "title": "Throughput OSD",
      "description": "Bytes por segundo lidos e escritos pelos OSDs.",
      "datasource": { "type": "prometheus", "uid": "${DS_PROM}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 36 },
      "targets": [
        { "expr": "sum(rate(ceph_osd_op_r_out_bytes_total{k8s_cluster_name=\"$cluster\"}[5m]))", "refId": "A", "legendFormat": "read" },
        { "expr": "sum(rate(ceph_osd_op_w_in_bytes_total{k8s_cluster_name=\"$cluster\"}[5m]))", "refId": "B", "legendFormat": "write" }
      ],
      "fieldConfig": { "defaults": { "unit": "Bps", "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 10 } } }
    },
    {
      "type": "timeseries",
      "id": 32,
      "title": "Latência Média OSD (apply / commit)",
      "description": "Latência média apply e commit dos OSDs (ms).",
      "datasource": { "type": "prometheus", "uid": "${DS_PROM}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 44 },
      "targets": [
        { "expr": "avg(ceph_osd_apply_latency_ms{k8s_cluster_name=\"$cluster\"})", "refId": "A", "legendFormat": "apply avg" },
        { "expr": "max(ceph_osd_apply_latency_ms{k8s_cluster_name=\"$cluster\"})", "refId": "B", "legendFormat": "apply max" },
        { "expr": "avg(ceph_osd_commit_latency_ms{k8s_cluster_name=\"$cluster\"})", "refId": "C", "legendFormat": "commit avg" },
        { "expr": "max(ceph_osd_commit_latency_ms{k8s_cluster_name=\"$cluster\"})", "refId": "D", "legendFormat": "commit max" }
      ],
      "fieldConfig": { "defaults": { "unit": "ms", "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 5 } } }
    },
    {
      "type": "timeseries",
      "id": 33,
      "title": "Latência Média por Operação (derivada)",
      "description": "Latência média calculada a partir de sum/count (read, write, rw).",
      "datasource": { "type": "prometheus", "uid": "${DS_PROM}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 44 },
      "targets": [
        { "expr": "sum(rate(ceph_osd_op_r_latency_sum_total{k8s_cluster_name=\"$cluster\"}[5m])) / sum(rate(ceph_osd_op_r_latency_count_total{k8s_cluster_name=\"$cluster\"}[5m]))", "refId": "A", "legendFormat": "read" },
        { "expr": "sum(rate(ceph_osd_op_w_latency_sum_total{k8s_cluster_name=\"$cluster\"}[5m])) / sum(rate(ceph_osd_op_w_latency_count_total{k8s_cluster_name=\"$cluster\"}[5m]))", "refId": "B", "legendFormat": "write" },
        { "expr": "sum(rate(ceph_osd_op_rw_latency_sum_total{k8s_cluster_name=\"$cluster\"}[5m])) / sum(rate(ceph_osd_op_rw_latency_count_total{k8s_cluster_name=\"$cluster\"}[5m]))", "refId": "C", "legendFormat": "read-modify-write" }
      ],
      "fieldConfig": { "defaults": { "unit": "s", "custom": { "drawStyle": "line", "lineWidth": 2 } } }
    },
    {
      "type": "timeseries",
      "id": 34,
      "title": "Recovery - Objetos & Bytes",
      "description": "Taxa de recuperação em objetos/s e bytes/s.",
      "datasource": { "type": "prometheus", "uid": "${DS_PROM}" },
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 52 },
      "targets": [
        { "expr": "sum(rate(ceph_osd_recovery_ops_total{k8s_cluster_name=\"$cluster\"}[5m]))", "refId": "A", "legendFormat": "recovery ops/s" },
        { "expr": "sum(rate(ceph_osd_recovery_bytes_total{k8s_cluster_name=\"$cluster\"}[5m]))", "refId": "B", "legendFormat": "recovery bytes/s" }
      ],
      "fieldConfig": {
        "defaults": { "custom": { "drawStyle": "line", "lineWidth": 2 } },
        "overrides": [
          { "matcher": { "id": "byName", "options": "recovery ops/s" }, "properties": [{ "id": "unit", "value": "ops" }] },
          { "matcher": { "id": "byName", "options": "recovery bytes/s" }, "properties": [{ "id": "unit", "value": "Bps" }] }
        ]
      }
    },
    {
      "type": "bargauge",
      "id": 35,
      "title": "Top 10 OSDs por Uso (%)",
      "description": "OSDs com maior percentual de utilização.",
      "datasource": { "type": "prometheus", "uid": "${DS_PROM}" },
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 52 },
      "targets": [
        { "expr": "topk(10, ceph_osd_stat_bytes_used{k8s_cluster_name=\"$cluster\"} / ceph_osd_stat_bytes{k8s_cluster_name=\"$cluster\"} * 100)", "refId": "A", "legendFormat": "osd.{{ceph_daemon}}" }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent", "min": 0, "max": 100,
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "green", "value": null },
            { "color": "yellow", "value": 70 },
            { "color": "red", "value": 85 }
          ]}
        }
      },
      "options": { "displayMode": "gradient", "orientation": "horizontal" }
    },

    { "type": "row", "id": 104, "title": "Pools", "gridPos": { "h": 1, "w": 24, "x": 0, "y": 59 }, "collapsed": false, "panels": [] },
    {
      "type": "table",
      "id": 40,
      "title": "Visão Geral dos Pools",
      "description": "Uso, objetos e capacidade disponível por pool.",
      "datasource": { "type": "prometheus", "uid": "${DS_PROM}" },
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 60 },
      "targets": [
        { "expr": "sum by (pool_id, name) (ceph_pool_bytes_used{k8s_cluster_name=\"$cluster\"} * on(pool_id) group_left(name) ceph_pool_metadata{k8s_cluster_name=\"$cluster\"})", "refId": "A", "format": "table", "instant": true, "legendFormat": "used" },
        { "expr": "sum by (pool_id, name) (ceph_pool_stored{k8s_cluster_name=\"$cluster\"} * on(pool_id) group_left(name) ceph_pool_metadata{k8s_cluster_name=\"$cluster\"})", "refId": "B", "format": "table", "instant": true },
        { "expr": "sum by (pool_id, name) (ceph_pool_max_avail{k8s_cluster_name=\"$cluster\"} * on(pool_id) group_left(name) ceph_pool_metadata{k8s_cluster_name=\"$cluster\"})", "refId": "C", "format": "table", "instant": true },
        { "expr": "sum by (pool_id, name) (ceph_pool_objects{k8s_cluster_name=\"$cluster\"} * on(pool_id) group_left(name) ceph_pool_metadata{k8s_cluster_name=\"$cluster\"})", "refId": "D", "format": "table", "instant": true },
        { "expr": "sum by (pool_id, name) (ceph_pool_percent_used{k8s_cluster_name=\"$cluster\"} * on(pool_id) group_left(name) ceph_pool_metadata{k8s_cluster_name=\"$cluster\"})", "refId": "E", "format": "table", "instant": true }
      ],
      "transformations": [
        { "id": "merge" },
        { "id": "organize", "options": {
          "excludeByName": { "Time": true, "__name__": true, "job": true, "instance": true, "k8s_cluster_name": true },
          "renameByName": {
            "pool_id": "Pool ID", "name": "Pool",
            "Value #A": "Used (raw)", "Value #B": "Stored", "Value #C": "Max Avail",
            "Value #D": "Objects", "Value #E": "Used %"
          }
        }}
      ],
      "fieldConfig": {
        "defaults": { "custom": { "align": "auto" } },
        "overrides": [
          { "matcher": { "id": "byName", "options": "Used (raw)" }, "properties": [{ "id": "unit", "value": "bytes" }] },
          { "matcher": { "id": "byName", "options": "Stored" }, "properties": [{ "id": "unit", "value": "bytes" }] },
          { "matcher": { "id": "byName", "options": "Max Avail" }, "properties": [{ "id": "unit", "value": "bytes" }] },
          { "matcher": { "id": "byName", "options": "Objects" }, "properties": [{ "id": "unit", "value": "short" }] },
          { "matcher": { "id": "byName", "options": "Used %" }, "properties": [
            { "id": "unit", "value": "percent" },
            { "id": "custom.cellOptions", "value": { "type": "gauge", "mode": "gradient" }}
          ]}
        ]
      }
    },
