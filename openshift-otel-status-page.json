  "description": "Status Page macro de clusters OpenShift com métricas OpenTelemetry (OTel). Drill-down para o dashboard de detalhe ao clicar no nome do cluster.",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 0,
  "id": null,
  "uid": "openshift-otel-status-page",
  "title": "OpenShift OTel - Cluster Health Status Page",
  "tags": ["openshift", "otel", "status-page"],
  "preload": false,
  "refresh": "30s",
  "schemaVersion": 40,
  "time": { "from": "now-1h", "to": "now" },
  "timepicker": {},
  "timezone": "browser",
  "weekStart": "",
  "templating": {
    "list": [
      {
        "current": { "text": ["All"], "value": ["$__all"] },
        "datasource": { "type": "prometheus", "uid": "af3dgaujkxssge" },
        "definition": "label_values(container_cpu_usage, k8s_cluster_name)",
        "includeAll": true,
        "multi": true,
        "label": "Cluster",
        "name": "k8s_cluster_name",
        "options": [],
        "query": { "qryType": 1, "query": "label_values(container_cpu_usage, k8s_cluster_name)", "refId": "PrometheusVariableQueryEditor-VariableQuery" },
        "refresh": 2,
        "regex": "",
        "sort": 1,
        "type": "query"
      }
    ]
  },
  "panels": [
