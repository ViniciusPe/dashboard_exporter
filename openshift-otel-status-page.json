      "options": {
        "code": { "language": "plaintext", "showLineNumbers": false, "showMiniMap": false },
        "content": "<div style=\"text-align:center; padding:10px 0;\"><h1 style=\"margin:0; font-size:24px;\">🖥️ OpenShift OTel - Cluster Health Status Page</h1><p style=\"margin:4px 0 0 0; color:#aaa; font-size:13px;\">Visão consolidada de saúde por cluster · clique no nome do cluster para abrir o detalhe</p></div>",
        "mode": "html"
