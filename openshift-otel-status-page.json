{
  "annotations": { "list": [{ "builtIn": 1, "datasource": { "type": "grafana", "uid": "-- Grafana --" }, "enable": true, "hide": true, "iconColor": "rgba(0, 211, 255, 1)", "name": "Annotations & Alerts", "type": "dashboard" }] },
  "description": "Status Page (macro) — uma linha por cluster OpenShift com saúde geral. Métricas via OTel (Mimir).",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "uid": "openshift-otel-status-page",
  "title": "OpenShift OTel - Cluster Health Status Page",
  "tags": ["openshift", "otel", "kubernetes", "status"],
  "refresh": "30s",
  "schemaVersion": 40,
  "time": { "from": "now-15m", "to": "now" },
  "timezone": "browser",
  "templating": {
    "list": [
      {
        "datasource": { "type": "prometheus", "uid": "af3dgaujkxssge" },
        "definition": "label_values(apiserver_request_total, k8s_cluster_name)",
        "includeAll": true,
        "label": "Cluster",
        "multi": true,
        "name": "k8s_cluster_name",
        "options": [],
        "query": { "query": "label_values(apiserver_request_total, k8s_cluster_name)", "refId": "StandardVariableQuery" },
        "refresh": 2,
        "regex": "",
        "sort": 1,
        "type": "query"
      }
    ]
  },
  "panels": [
    {
      "type": "table",
      "id": 1,
      "title": "Saúde dos Clusters OpenShift (clique no cluster para abrir o detail)",
      "datasource": { "type": "prometheus", "uid": "af3dgaujkxssge" },
      "gridPos": { "h": 22, "w": 24, "x": 0, "y": 0 },
      "options": { "showHeader": true, "cellHeight": "md", "footer": { "show": false } },
      "fieldConfig": {
        "defaults": {
          "custom": { "align": "center", "cellOptions": { "type": "color-background" }, "filterable": true, "inspect": false }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Cluster" },
            "properties": [
              { "id": "custom.cellOptions", "value": { "type": "color-text" } },
              { "id": "custom.width", "value": 220 },
              {
                "id": "links",
                "value": [
                  {
                    "title": "Abrir detalhe do cluster ${__data.fields.Cluster}",
                    "url": "/d/openshift-otel-cluster-detail/openshift-otel-cluster-detail?var-k8s_cluster_name=${__data.fields.Cluster}&${__url_time_range}",
                    "targetBlank": false
                  }
                ]
              }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "CPU (cores)" },
            "properties": [
              { "id": "unit", "value": "short" },
              { "id": "decimals", "value": 2 },
              { "id": "custom.cellOptions", "value": { "type": "gauge", "mode": "gradient" } },
              { "id": "thresholds", "value": { "mode": "absolute", "steps": [{ "color": "green" }, { "color": "yellow", "value": 8 }, { "color": "orange", "value": 32 }, { "color": "red", "value": 128 }] } }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "Memória (bytes em uso)" },
            "properties": [
              { "id": "unit", "value": "bytes" },
              { "id": "custom.cellOptions", "value": { "type": "gauge", "mode": "gradient" } },
              { "id": "thresholds", "value": { "mode": "absolute", "steps": [{ "color": "green" }, { "color": "yellow", "value": 17179869184 }, { "color": "orange", "value": 68719476736 }, { "color": "red", "value": 274877906944 }] } }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "Nodes NotReady" },
            "properties": [
              { "id": "unit", "value": "short" },
              { "id": "thresholds", "value": { "mode": "absolute", "steps": [{ "color": "green" }, { "color": "red", "value": 1 }] } }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "Containers em CrashLoop/OOM/Error" },
            "properties": [
              { "id": "unit", "value": "short" },
              { "id": "thresholds", "value": { "mode": "absolute", "steps": [{ "color": "green" }, { "color": "yellow", "value": 1 }, { "color": "red", "value": 5 }] } }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "Volumes >85% uso" },
            "properties": [
              { "id": "unit", "value": "short" },
              { "id": "thresholds", "value": { "mode": "absolute", "steps": [{ "color": "green" }, { "color": "yellow", "value": 1 }, { "color": "red", "value": 5 }] } }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "Disco Node max % uso" },
            "properties": [
              { "id": "unit", "value": "percent" },
              { "id": "decimals", "value": 1 },
              { "id": "custom.cellOptions", "value": { "type": "gauge", "mode": "gradient" } },
              { "id": "thresholds", "value": { "mode": "absolute", "steps": [{ "color": "green" }, { "color": "yellow", "value": 70 }, { "color": "orange", "value": 85 }, { "color": "red", "value": 90 }] } }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "Network Drop (pps)" },
            "properties": [
              { "id": "unit", "value": "pps" },
              { "id": "decimals", "value": 2 },
              { "id": "thresholds", "value": { "mode": "absolute", "steps": [{ "color": "green" }, { "color": "yellow", "value": 1 }, { "color": "red", "value": 50 }] } }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "HAProxy 5xx (req/s)" },
            "properties": [
              { "id": "unit", "value": "reqps" },
              { "id": "decimals", "value": 3 },
              { "id": "thresholds", "value": { "mode": "absolute", "steps": [{ "color": "green" }, { "color": "yellow", "value": 0.1 }, { "color": "red", "value": 1 }] } }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "API Server 5xx (%)" },
            "properties": [
              { "id": "unit", "value": "percentunit" },
              { "id": "decimals", "value": 3 },
              { "id": "thresholds", "value": { "mode": "absolute", "steps": [{ "color": "green" }, { "color": "yellow", "value": 0.01 }, { "color": "red", "value": 0.05 }] } }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "etcd DB Size (bytes)" },
            "properties": [
              { "id": "unit", "value": "bytes" },
              { "id": "thresholds", "value": { "mode": "absolute", "steps": [{ "color": "green" }, { "color": "yellow", "value": 4000000000 }, { "color": "red", "value": 7000000000 }] } }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "etcd fsync avg (s)" },
            "properties": [
              { "id": "unit", "value": "s" },
              { "id": "decimals", "value": 4 },
              { "id": "thresholds", "value": { "mode": "absolute", "steps": [{ "color": "green" }, { "color": "yellow", "value": 0.025 }, { "color": "red", "value": 0.1 }] } }
            ]
          }
        ]
      },
      "targets": [
        { "refId": "CPU",        "expr": "sum by(k8s_cluster_name) (k8s_node_cpu_usage{k8s_cluster_name=~\"$k8s_cluster_name\"})", "format": "table", "instant": true, "legendFormat": "__auto" },
        { "refId": "MEM",        "expr": "sum by(k8s_cluster_name) (k8s_node_memory_usage_bytes{k8s_cluster_name=~\"$k8s_cluster_name\"})", "format": "table", "instant": true },
        { "refId": "NODES_NR",   "expr": "sum by(k8s_cluster_name) (k8s_node_condition{k8s_cluster_name=~\"$k8s_cluster_name\", condition=\"Ready\", status!=\"true\"})", "format": "table", "instant": true },
        { "refId": "CTR_BAD",    "expr": "sum by(k8s_cluster_name) (k8s_container_status_reason{k8s_cluster_name=~\"$k8s_cluster_name\", reason=~\"CrashLoopBackOff|OOMKilled|Error|ImagePullBackOff|ErrImagePull|CreateContainerError|ContainerCreating\"} > 0)", "format": "table", "instant": true },
        { "refId": "VOL_HIGH",   "expr": "sum by(k8s_cluster_name) ((k8s_pod_volume_usage_bytes{k8s_cluster_name=~\"$k8s_cluster_name\"} / clamp_min(k8s_volume_capacity_bytes{k8s_cluster_name=~\"$k8s_cluster_name\"},1)) > 0.85)", "format": "table", "instant": true },
        { "refId": "DISK_PCT",   "expr": "max by(k8s_cluster_name) (100 * (1 - (k8s_node_filesystem_available_bytes{k8s_cluster_name=~\"$k8s_cluster_name\"} / clamp_min(k8s_node_filesystem_capacity_bytes{k8s_cluster_name=~\"$k8s_cluster_name\"},1))))", "format": "table", "instant": true },
        { "refId": "NET_DROP",   "expr": "sum by(k8s_cluster_name) (rate(node_network_receive_drop_total{k8s_cluster_name=~\"$k8s_cluster_name\"}[5m]) + rate(node_network_transmit_drop_total{k8s_cluster_name=~\"$k8s_cluster_name\"}[5m]))", "format": "table", "instant": true },
        { "refId": "HA5xx",      "expr": "sum by(k8s_cluster_name) (rate(haproxy_backend_http_responses_total{k8s_cluster_name=~\"$k8s_cluster_name\", code=\"5xx\"}[5m]))", "format": "table", "instant": true },
        { "refId": "API5xx",     "expr": "sum by(k8s_cluster_name) (rate(apiserver_request_total{k8s_cluster_name=~\"$k8s_cluster_name\", code=~\"5..\"}[5m])) / clamp_min(sum by(k8s_cluster_name) (rate(apiserver_request_total{k8s_cluster_name=~\"$k8s_cluster_name\"}[5m])), 1)", "format": "table", "instant": true },
        { "refId": "ETCD_DB",    "expr": "max by(k8s_cluster_name) (etcd_mvcc_db_total_size_in_bytes{k8s_cluster_name=~\"$k8s_cluster_name\"})", "format": "table", "instant": true },
        { "refId": "ETCD_FSYNC", "expr": "sum by(k8s_cluster_name) (rate(etcd_disk_wal_fsync_duration_seconds_sum{k8s_cluster_name=~\"$k8s_cluster_name\"}[5m])) / clamp_min(sum by(k8s_cluster_name) (rate(etcd_disk_wal_fsync_duration_seconds_count{k8s_cluster_name=~\"$k8s_cluster_name\"}[5m])), 1)", "format": "table", "instant": true }
      ],
      "transformations": [
        { "id": "merge", "options": {} },
        {
          "id": "organize",
          "options": {
            "excludeByName": { "Time": true, "job": true, "instance": true, "__name__": true },
            "indexByName": {
              "k8s_cluster_name": 0,
              "Value #CPU": 1,
              "Value #MEM": 2,
              "Value #NODES_NR": 3,
              "Value #CTR_BAD": 4,
              "Value #VOL_HIGH": 5,
              "Value #DISK_PCT": 6,
              "Value #NET_DROP": 7,
              "Value #HA5xx": 8,
              "Value #API5xx": 9,
              "Value #ETCD_DB": 10,
              "Value #ETCD_FSYNC": 11
            },
            "renameByName": {
              "k8s_cluster_name": "Cluster",
              "Value #CPU": "CPU (cores)",
              "Value #MEM": "Memória (bytes em uso)",
              "Value #NODES_NR": "Nodes NotReady",
              "Value #CTR_BAD": "Containers em CrashLoop/OOM/Error",
              "Value #VOL_HIGH": "Volumes >85% uso",
              "Value #DISK_PCT": "Disco Node max % uso",
              "Value #NET_DROP": "Network Drop (pps)",
              "Value #HA5xx": "HAProxy 5xx (req/s)",
              "Value #API5xx": "API Server 5xx (%)",
              "Value #ETCD_DB": "etcd DB Size (bytes)",
              "Value #ETCD_FSYNC": "etcd fsync avg (s)"
            }
          }
        }
      ]
    }
  ]
}
