    },
    {
      "type": "text",
      "id": 2,
      "gridPos": { "h": 2, "w": 24, "x": 0, "y": 3 },
      "fieldConfig": { "defaults": {}, "overrides": [] },
      "options": {
        "code": { "language": "plaintext", "showLineNumbers": false, "showMiniMap": false },
        "content": "<div style=\"display:flex; gap:24px; justify-content:center; padding:8px 0; font-size:13px;\"><span>🟢 Saudável</span><span>🟡 Atenção</span><span>🔴 Crítico</span></div>",
        "mode": "html"
      },
      "pluginVersion": "11.3.0",
      "title": "",
      "transparent": true
    },
    {
      "type": "table",
      "id": 3,
      "title": "Infraestrutura",
      "datasource": { "type": "prometheus", "uid": "af3dgaujkxssge" },
      "gridPos": { "h": 18, "w": 24, "x": 0, "y": 5 },
      "pluginVersion": "11.3.0",
      "options": {
        "cellHeight": "md",
        "footer": { "countRows": false, "fields": "", "reducer": ["sum"], "show": false },
        "frameIndex": 0,
        "showHeader": true,
        "sortBy": [{ "desc": true, "displayName": "🚨 Pods Problem." }]
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "center",
            "cellOptions": { "type": "color-background", "mode": "gradient" },
            "filterable": true,
            "inspect": false,
            "minWidth": 110
          },
          "decimals": 1,
          "mappings": [],
          "noValue": "0"
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Cluster" },
            "properties": [
              { "id": "custom.width", "value": 280 },
              { "id": "custom.align", "value": "left" },
              { "id": "custom.cellOptions", "value": { "type": "color-text" } },
              { "id": "color", "value": { "fixedColor": "white", "mode": "fixed" } },
              {
                "id": "links",
                "value": [
                  {
                    "targetBlank": false,
                    "title": "🔍 Ver detalhes do cluster",
                    "url": "/d/openshift-otel-cluster-detail/openshift-otel-cluster-detail?var-k8s_cluster_name=${__data.fields.Cluster}"
                  }
                ]
              }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "⚡ CPU %" },
            "properties": [
              { "id": "unit", "value": "percent" },
              { "id": "thresholds", "value": { "mode": "absolute", "steps": [{ "color": "#37872D", "value": null }, { "color": "orange", "value": 70 }, { "color": "#C4162A", "value": 85 }] } }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "🧠 Memory %" },
            "properties": [
              { "id": "unit", "value": "percent" },
              { "id": "thresholds", "value": { "mode": "absolute", "steps": [{ "color": "#37872D", "value": null }, { "color": "orange", "value": 70 }, { "color": "#C4162A", "value": 85 }] } }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "🖥️ Nodes" },
            "properties": [
              { "id": "decimals", "value": 0 },
              { "id": "thresholds", "value": { "mode": "absolute", "steps": [{ "color": "#37872D", "value": null }] } }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "📦 Pods" },
            "properties": [
              { "id": "decimals", "value": 0 },
              { "id": "thresholds", "value": { "mode": "absolute", "steps": [{ "color": "blue", "value": null }] } }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "🚨 Pods Problem." },
            "properties": [
              { "id": "decimals", "value": 0 },
              { "id": "thresholds", "value": { "mode": "absolute", "steps": [{ "color": "#37872D", "value": null }, { "color": "orange", "value": 1 }, { "color": "#C4162A", "value": 5 }] } }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "🔁 Restarts (1h)" },
            "properties": [
              { "id": "decimals", "value": 0 },
              { "id": "thresholds", "value": { "mode": "absolute", "steps": [{ "color": "#37872D", "value": null }, { "color": "orange", "value": 5 }, { "color": "#C4162A", "value": 20 }] } }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "💾 PVCs Críticos" },
            "properties": [
              { "id": "decimals", "value": 0 },
              { "id": "thresholds", "value": { "mode": "absolute", "steps": [{ "color": "#37872D", "value": null }, { "color": "orange", "value": 1 }, { "color": "#C4162A", "value": 3 }] } }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "💿 Disk Node" },
            "properties": [
              { "id": "decimals", "value": 0 },
              { "id": "thresholds", "value": { "mode": "absolute", "steps": [{ "color": "#37872D", "value": null }, { "color": "orange", "value": 1 }, { "color": "#C4162A", "value": 3 }] } }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "🌐 Net Drops" },
            "properties": [
              { "id": "decimals", "value": 2 },
              { "id": "unit", "value": "pps" },
              { "id": "thresholds", "value": { "mode": "absolute", "steps": [{ "color": "dark-green", "value": null }, { "color": "orange", "value": 1 }, { "color": "dark-red", "value": 10 }] } }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "🔀 HAProxy 5xx" },
            "properties": [
              { "id": "unit", "value": "reqps" },
              { "id": "decimals", "value": 2 },
              { "id": "thresholds", "value": { "mode": "absolute", "steps": [{ "color": "#37872D", "value": null }, { "color": "orange", "value": 1 }, { "color": "#C4162A", "value": 10 }] } }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "🛰️ API 5xx %" },
            "properties": [
              { "id": "unit", "value": "percent" },
              { "id": "decimals", "value": 2 },
              { "id": "thresholds", "value": { "mode": "absolute", "steps": [{ "color": "#37872D", "value": null }, { "color": "orange", "value": 1 }, { "color": "#C4162A", "value": 5 }] } }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "🗄️ ETCD DB" },
            "properties": [
              { "id": "unit", "value": "bytes" },
              { "id": "decimals", "value": 1 },
              { "id": "thresholds", "value": { "mode": "absolute", "steps": [{ "color": "#37872D", "value": null }, { "color": "orange", "value": 4000000000 }, { "color": "#C4162A", "value": 7000000000 }] } }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "⏱️ etcd fsync" },
            "properties": [
              { "id": "unit", "value": "s" },
              { "id": "decimals", "value": 3 },
              { "id": "thresholds", "value": { "mode": "absolute", "steps": [{ "color": "#37872D", "value": null }, { "color": "orange", "value": 0.025 }, { "color": "#C4162A", "value": 0.1 }] } }
            ]
          }
        ]
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "af3dgaujkxssge" },
          "editorMode": "code",
          "expr": "count by (k8s_cluster_name) (count by (k8s_cluster_name, k8s_node_name) (k8s_node_cpu_usage{k8s_cluster_name=~\"$k8s_cluster_name\"}))",
          "format": "table",
          "instant": true,
          "refId": "NODES"
        },
        {
          "datasource": { "type": "prometheus", "uid": "af3dgaujkxssge" },
          "editorMode": "code",
          "expr": "count by (k8s_cluster_name) (count by (k8s_cluster_name, k8s_pod_name) (k8s_pod_cpu_usage{k8s_cluster_name=~\"$k8s_cluster_name\"}))",
          "format": "table",
          "instant": true,
          "refId": "PODS"
        },
        {
          "datasource": { "type": "prometheus", "uid": "af3dgaujkxssge" },
          "editorMode": "code",
          "expr": "avg by (k8s_cluster_name) (k8s_node_cpu_usage{k8s_cluster_name=~\"$k8s_cluster_name\"}) * 100",
          "format": "table",
          "instant": true,
          "refId": "CPU"
        },
        {
          "datasource": { "type": "prometheus", "uid": "af3dgaujkxssge" },
          "editorMode": "code",
          "expr": "100 * sum by (k8s_cluster_name) (k8s_node_memory_usage_bytes{k8s_cluster_name=~\"$k8s_cluster_name\"}) / clamp_min(sum by (k8s_cluster_name) (kube_node_status_allocatable{k8s_cluster_name=~\"$k8s_cluster_name\", resource=\"memory\"}), 1)",
          "format": "table",
          "instant": true,
          "refId": "MEM"
        },
        {
          "datasource": { "type": "prometheus", "uid": "af3dgaujkxssge" },
          "editorMode": "code",
          "expr": "count by (k8s_cluster_name) (k8s_container_status_reason{k8s_cluster_name=~\"$k8s_cluster_name\"} > 0) or sum by (k8s_cluster_name) (kube_node_info{k8s_cluster_name=~\"$k8s_cluster_name\"}) * 0",
          "format": "table",
          "instant": true,
          "refId": "PROBLEM"
        },
        {
          "datasource": { "type": "prometheus", "uid": "af3dgaujkxssge" },
          "editorMode": "code",
          "expr": "sum by (k8s_cluster_name) (increase(k8s_container_restarts{k8s_cluster_name=~\"$k8s_cluster_name\"}[1h])) or sum by (k8s_cluster_name) (kube_node_info{k8s_cluster_name=~\"$k8s_cluster_name\"}) * 0",
          "format": "table",
          "instant": true,
          "refId": "RESTARTS"
        },
        {
          "datasource": { "type": "prometheus", "uid": "af3dgaujkxssge" },
          "editorMode": "code",
          "expr": "count by (k8s_cluster_name) ((k8s_pod_volume_usage_bytes{k8s_cluster_name=~\"$k8s_cluster_name\"} / clamp_min(k8s_volume_capacity_bytes{k8s_cluster_name=~\"$k8s_cluster_name\"}, 1)) * 100 >= 85) or sum by (k8s_cluster_name) (kube_node_info{k8s_cluster_name=~\"$k8s_cluster_name\"}) * 0",
          "format": "table",
          "instant": true,
          "refId": "PVC"
        },
        {
          "datasource": { "type": "prometheus", "uid": "af3dgaujkxssge" },
          "editorMode": "code",
          "expr": "count by (k8s_cluster_name) (max by (k8s_cluster_name, k8s_node_name) ((k8s_node_filesystem_capacity_bytes{k8s_cluster_name=~\"$k8s_cluster_name\"} - k8s_node_filesystem_available_bytes{k8s_cluster_name=~\"$k8s_cluster_name\"}) / clamp_min(k8s_node_filesystem_capacity_bytes{k8s_cluster_name=~\"$k8s_cluster_name\"}, 1) * 100) > 85) or sum by (k8s_cluster_name) (kube_node_info{k8s_cluster_name=~\"$k8s_cluster_name\"}) * 0",
          "format": "table",
          "instant": true,
          "refId": "DISK"
        },
        {
          "datasource": { "type": "prometheus", "uid": "af3dgaujkxssge" },
          "editorMode": "code",
          "expr": "sum by (k8s_cluster_name) (rate(node_network_receive_drop_total{k8s_cluster_name=~\"$k8s_cluster_name\", device!=\"lo\"}[5m])) + sum by (k8s_cluster_name) (rate(node_network_transmit_drop_total{k8s_cluster_name=~\"$k8s_cluster_name\", device!=\"lo\"}[5m]))",
          "format": "table",
          "instant": true,
          "refId": "NET"
        },
        {
          "datasource": { "type": "prometheus", "uid": "af3dgaujkxssge" },
          "editorMode": "code",
          "expr": "sum by (k8s_cluster_name) (rate(haproxy_backend_http_responses_total{code=\"5xx\", k8s_cluster_name=~\"$k8s_cluster_name\"}[5m])) or sum by (k8s_cluster_name) (kube_node_info{k8s_cluster_name=~\"$k8s_cluster_name\"}) * 0",
          "format": "table",
          "instant": true,
          "refId": "HAPROXY"
        },
        {
          "datasource": { "type": "prometheus", "uid": "af3dgaujkxssge" },
          "editorMode": "code",
          "expr": "100 * sum by (k8s_cluster_name) (rate(apiserver_request_total{code=~\"5..\", k8s_cluster_name=~\"$k8s_cluster_name\"}[5m])) / clamp_min(sum by (k8s_cluster_name) (rate(apiserver_request_total{k8s_cluster_name=~\"$k8s_cluster_name\"}[5m])), 1)",
          "format": "table",
          "instant": true,
          "refId": "API5XX"
        },
        {
          "datasource": { "type": "prometheus", "uid": "af3dgaujkxssge" },
          "editorMode": "code",
          "expr": "max by (k8s_cluster_name) (etcd_mvcc_db_total_size_in_bytes{k8s_cluster_name=~\"$k8s_cluster_name\"})",
          "format": "table",
          "instant": true,
          "refId": "ETCD"
        },
        {
          "datasource": { "type": "prometheus", "uid": "af3dgaujkxssge" },
          "editorMode": "code",
          "expr": "sum by (k8s_cluster_name) (rate(etcd_disk_wal_fsync_duration_seconds_sum{k8s_cluster_name=~\"$k8s_cluster_name\"}[5m])) / clamp_min(sum by (k8s_cluster_name) (rate(etcd_disk_wal_fsync_duration_seconds_count{k8s_cluster_name=~\"$k8s_cluster_name\"}[5m])), 1)",
          "format": "table",
          "instant": true,
          "refId": "ETCDFSYNC"
        }
      ],
      "transformations": [
        { "id": "merge", "options": {} },
        {
          "id": "organize",
          "options": {
            "excludeByName": { "Time": true },
            "indexByName": {
              "k8s_cluster_name": 0,
              "Value #NODES": 1,
              "Value #PODS": 2,
              "Value #CPU": 3,
              "Value #MEM": 4,
              "Value #PROBLEM": 5,
              "Value #RESTARTS": 6,
              "Value #PVC": 7,
              "Value #DISK": 8,
              "Value #NET": 9,
              "Value #HAPROXY": 10,
              "Value #API5XX": 11,
              "Value #ETCD": 12,
              "Value #ETCDFSYNC": 13
            },
            "renameByName": {
              "k8s_cluster_name": "Cluster",
              "Value #NODES": "🖥️ Nodes",
              "Value #PODS": "📦 Pods",
              "Value #CPU": "⚡ CPU %",
              "Value #MEM": "🧠 Memory %",
              "Value #PROBLEM": "🚨 Pods Problem.",
              "Value #RESTARTS": "🔁 Restarts (1h)",
              "Value #PVC": "💾 PVCs Críticos",
              "Value #DISK": "💿 Disk Node",
              "Value #NET": "🌐 Net Drops",
              "Value #HAPROXY": "🔀 HAProxy 5xx",
              "Value #API5XX": "🛰️ API 5xx %",
              "Value #ETCD": "🗄️ ETCD DB",
              "Value #ETCDFSYNC": "⏱️ etcd fsync"
            }
          }
        }
      ]
    }
  ]
}
